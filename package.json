{
  "name": "palang-ic",
  "private": true,
  "version": "0.0.0",
  "description": "Add a palang to MyKad copies, entirely in your browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
