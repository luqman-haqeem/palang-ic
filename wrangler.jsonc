{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "palang-ic",
  "compatibility_date": "2026-09-30",
  // Assets-only Worker: no "main" script. Cloudflare serves dist/ from its edge
  // and never sees a scan, because all image work happens in the browser.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true },
  // Required by `wrangler preview`, which Workers Builds runs for non-production
  // branches. Empty: assets and compatibility settings stay at the top level.
  "previews": {}
}
